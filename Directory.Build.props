<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldApp)' == ''">
    <RimWorldApp>$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app</RimWorldApp>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>$(RimWorldApp)/Contents/Resources/Data/Managed</RimWorldManaged>
  </PropertyGroup>

  <Target Name="CheckRimWorldManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldManaged)/Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found at '$(RimWorldManaged)'. Set the RimWorldManaged property (env var or Local.props) to the game's Managed directory." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />
</Project>
