<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BootstrapCheck</AssemblyName>
    <RootNamespace>BootstrapCheck</RootNamespace>
    <OutputPath>..\Assemblies\</OutputPath>
  </PropertyGroup>

  <!-- Reference only. 0Harmony.dll ships with the Harmony mod, declared as a dependency in About.xml. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
