<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- A PatchOperation whose xpath matches nothing logs an error, so a silent log is the pass condition. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Bed"]/description</xpath>
    <value>
      <description>A simple bed for a colonist to sleep in. [BootstrapCheck] patched this description.</description>
    </value>
  </Operation>

</Patch>
